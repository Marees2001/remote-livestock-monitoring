 215:Core/Src/SSD1306.c **** /** Flush the buffer to the display via I2C. */
 216:Core/Src/SSD1306.c **** static void s_displayBuffer(OLED_t *oled)
 217:Core/Src/SSD1306.c **** {
 218:Core/Src/SSD1306.c ****     for (uint8_t page = 0; page < 8; page++) {
 219:Core/Src/SSD1306.c ****         s_execute(oled, 0xB0 + page);
 220:Core/Src/SSD1306.c ****         s_execute(oled, 0x00);
