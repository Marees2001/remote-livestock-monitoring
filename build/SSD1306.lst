 280:Core/Src/SSD1306.c **** /** Bresenham circle-quarter helper for rounded rects. */
 281:Core/Src/SSD1306.c **** static void s_drawCircleHelper(OLED_t *oled, int x0, int y0, int r, uint8_t corner)
 282:Core/Src/SSD1306.c **** {
 283:Core/Src/SSD1306.c ****     int f     = 1 - r;
 284:Core/Src/SSD1306.c ****     int ddx   = 1;
 285:Core/Src/SSD1306.c ****     int ddy   = -2 * r;
 286:Core/Src/SSD1306.c ****     int x = 0, y = r;
 287:Core/Src/SSD1306.c ****     while (x <= y) {
 288:Core/Src/SSD1306.c ****         if (f >= 0) { y--; ddy += 2; f += ddy; }
 289:Core/Src/SSD1306.c ****         x++; ddx += 2; f += ddx;
 290:Core/Src/SSD1306.c ****         if (corner & 0x1) { s_drawPixel(oled, x0-x, y0-y); s_drawPixel(oled, x0-y, y0-x); }
 291:Core/Src/SSD1306.c ****         if (corner & 0x2) { s_drawPixel(oled, x0+x, y0-y); s_drawPixel(oled, x0+y, y0-x); }
 292:Core/Src/SSD1306.c ****         if (corner & 0x4) { s_drawPixel(oled, x0+x, y0+y); s_drawPixel(oled, x0+y, y0+x); }
 293:Core/Src/SSD1306.c ****         if (corner & 0x8) { s_drawPixel(oled, x0-y, y0+x); s_drawPixel(oled, x0-x, y0+y); }
 294:Core/Src/SSD1306.c ****     }
 295:Core/Src/SSD1306.c **** }
