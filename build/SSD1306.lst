 222:Core/Src/SSD1306.c ****         for (uint8_t col = 0; col < 128; col++)
 223:Core/Src/SSD1306.c ****             s_sendData(oled, oled->buffer[page * 128 + col]);
 224:Core/Src/SSD1306.c ****     }
 225:Core/Src/SSD1306.c **** }
