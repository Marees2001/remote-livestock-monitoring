 158:Core/Src/SSD1306.c **** /** Send one command byte over I2C. */
 159:Core/Src/SSD1306.c **** static void s_execute(OLED_t *oled, uint8_t cmd)
 160:Core/Src/SSD1306.c **** {
 161:Core/Src/SSD1306.c ****     uint8_t buf[2] = { 0x00, cmd };
 162:Core/Src/SSD1306.c ****     HAL_I2C_Master_Transmit(oled->hi2c, (uint16_t)(oled->address << 1),
 163:Core/Src/SSD1306.c ****                             buf, 2, HAL_MAX_DELAY);
 164:Core/Src/SSD1306.c **** }
 165:Core/Src/SSD1306.c **** 
 166:Core/Src/SSD1306.c **** /** Send one data byte over I2C. */
 167:Core/Src/SSD1306.c **** static void s_sendData(OLED_t *oled, uint8_t data)
 168:Core/Src/SSD1306.c **** {
 169:Core/Src/SSD1306.c ****     uint8_t buf[2] = { 0x40, data };
 170:Core/Src/SSD1306.c ****     HAL_I2C_Master_Transmit(oled->hi2c, (uint16_t)(oled->address << 1),
 171:Core/Src/SSD1306.c ****                             buf, 2, HAL_MAX_DELAY);
 172:Core/Src/SSD1306.c **** }
 173:Core/Src/SSD1306.c **** 
 174:Core/Src/SSD1306.c **** /** Clamp x to [0, width-1]. */
 175:Core/Src/SSD1306.c **** static uint8_t s_checkX(OLED_t *oled, uint8_t x)
