  10:Core/Inc/controller.h **** struct GSMS_INITIALIZATION {
  11:Core/Inc/controller.h ****     uint8_t init; // command:AT ,Initialization status (0 or 1)
  12:Core/Inc/controller.h ****     uint8_t sim_sta; //command: AT-CSPIN? ,SIM card status (0-3). 0: Not checked, 1: Ready, 2: Not 
  13:Core/Inc/controller.h ****     uint8_t set_uart_conf; // command: AT+ICF?,UART configuration status.
  14:Core/Inc/controller.h ****     // Bit read operations: 0: NOT SET, 1:Baud rate 2: Word length, 3: Stop bits, 4: Parity
  15:Core/Inc/controller.h ****     uint8_t req_rssi; // command: AT+CSQ?, Request signal quality in dbm.
  16:Core/Inc/controller.h ****     uint8_t req_time; // command: AT+CCLK?, Request network time.
  17:Core/Inc/controller.h **** }gsmInit;
  18:Core/Inc/controller.h **** 
  19:Core/Inc/controller.h **** /*Structure for controller status*/
  20:Core/Inc/controller.h **** struct CONTROLLER_STATUS {
  21:Core/Inc/controller.h ****     uint8_t init_gsm; // GSM initialization status (0 or 1)
  22:Core/Inc/controller.h ****     float tds_value; // TDS sensor value
  23:Core/Inc/controller.h ****     float temp_value; // Temperature sensor value
  24:Core/Inc/controller.h ****     float hum_value; // Humidity sensor value
  25:Core/Inc/controller.h ****     uint8_t rssi; // GSM signal strength (0-31)
  26:Core/Inc/controller.h ****     uint8_t alm_sta; // Alarm status (0 or 1)
  27:Core/Inc/controller.h ****     uint8_t lam_status; // Lamp status (0 or 1)
  28:Core/Inc/controller.h ****     uint8_t fan_status; // Fan status (0 or 1)
  29:Core/Inc/controller.h ****     uint8_t fence_status; // Fence status (0 or 1)
  30:Core/Inc/controller.h **** };
  31:Core/Inc/controller.h **** 
  32:Core/Inc/controller.h **** /*Structure for controller settings*/
  33:Core/Inc/controller.h **** struct CONTROLLER_SETTINGS {
  34:Core/Inc/controller.h ****     uint8_t mx_temp; // Max threshold for temperature
  35:Core/Inc/controller.h ****     uint8_t mn_temp; // Min threshold for temperature
  36:Core/Inc/controller.h ****     uint8_t mx_hum; // Max threshold for humidity
  37:Core/Inc/controller.h ****     uint8_t mn_hum; // Min threshold for humidity
  38:Core/Inc/controller.h ****     uint8_t mx_tds; // Max threshold for TDS; 
