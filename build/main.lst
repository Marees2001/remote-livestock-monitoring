  73:Core/Src/main.c **** void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart){
  74:Core/Src/main.c ****     if(huart->Instance == USART1){
  75:Core/Src/main.c ****       // Restart UART reception for the next data
  76:Core/Src/main.c ****       memset(gsm_rx_buffer, 0, sizeof(gsm_rx_buffer)); // Clear the buffer before receiving new dat
  77:Core/Src/main.c ****       HAL_UART_Receive_IT(&huart1, (uint8_t*)gsm_rx_buffer, sizeof(gsm_rx_buffer));
  78:Core/Src/main.c ****       receive_bytes = strlen(gsm_rx_buffer); // Update the number of bytes received
  79:Core/Src/main.c ****       if(!receive_bytes) return; // Update the number of bytes received
  80:Core/Src/main.c ****       // Process the received data as needed
  81:Core/Src/main.c ****       if(!gsmInit.init && !strcmp(gsm_rx_buffer, "OK")) gsmInit.init = 1; // Basic command to check
  82:Core/Src/main.c ****       else if(!gsmInit.sim_sta) sscanf(gsm_rx_buffer, "+CSMINS: %*d,%d", &gsmInit.sim_sta); // Chec
  83:Core/Src/main.c ****       else if(!gsmInit.req_rssi) {
  84:Core/Src/main.c ****         sscanf(gsm_rx_buffer, "+CSQ: %d,%*d", &rlm.sta.rssi); // Check signal quality
  85:Core/Src/main.c ****         gsmInit.req_rssi = 1; // Mark RSSI as received
  86:Core/Src/main.c ****       }
  87:Core/Src/main.c ****       // else if(!gsmInit.req_time) {
  88:Core/Src/main.c ****       //   sscanf(gsm_rx_buffer, "+CCLK: \"%[^\"]\"", gsm_rx_buffer); // Request network time
  89:Core/Src/main.c ****       //   gsmInit.req_time = 1; // Mark time as received
  90:Core/Src/main.c ****       // }
