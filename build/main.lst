  73:Core/Src/main.c **** void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart){
  74:Core/Src/main.c ****   if(huart->Instance == USART1){
  75:Core/Src/main.c ****     // Restart UART reception for the next data
  76:Core/Src/main.c ****     memset(gsm_rx_buffer, 0, sizeof(gsm_rx_buffer)); // Clear the buffer before receiving new data
  77:Core/Src/main.c ****     HAL_UART_Receive_IT(&huart1, (uint8_t*)gsm_rx_buffer, sizeof(gsm_rx_buffer));
  78:Core/Src/main.c ****     receive_bytes = strlen(gsm_rx_buffer); // Update the number of bytes received
  79:Core/Src/main.c ****     printf("Received GSM data: %s\n\r", gsm_rx_buffer); // Print the received data for debugging
  80:Core/Src/main.c ****     if(!receive_bytes) return; // Update the number of bytes received
  81:Core/Src/main.c ****     // Process the received data as needed
  82:Core/Src/main.c ****     if(!BITREAD(rlm.sta.init_gsm, 0) && !strcmp(gsm_rx_buffer, "OK")) BITSET(rlm.sta.init_gsm, 0); 
  83:Core/Src/main.c ****     else if(!BITREAD(rlm.sta.init_gsm, 1)) {
  84:Core/Src/main.c ****       uint8_t sim_status = 0;
  85:Core/Src/main.c ****       sscanf(gsm_rx_buffer, "+CSMINS: %*d,%d", &sim_status); // Check SIM card status
  86:Core/Src/main.c ****       if(sim_status) BITSET(rlm.sta.init_gsm, 1); // Mark SIM card status as received
  87:Core/Src/main.c ****     }
  88:Core/Src/main.c ****     else if(!BITREAD(rlm.sta.init_gsm, 3)) {
  89:Core/Src/main.c ****       sscanf(gsm_rx_buffer, "+CSQ: %d,%*d", &rlm.sta.rssi); // Check signal quality
  90:Core/Src/main.c ****       BITSET(rlm.sta.init_gsm, 3); // Mark RSSI as received
ARM GAS  C:\Users\maree\AppData\Local\Temp\ccQwMFKI.s 			page 3


  91:Core/Src/main.c ****     }
  92:Core/Src/main.c ****     else if(!BITREAD(rlm.sta.init_gsm, 4) && !strcmp(gsm_rx_buffer, "OK")) BITSET(rlm.sta.init_gsm,
  93:Core/Src/main.c ****     else if(!BITREAD(rlm.sta.init_gsm, 5) && !strcmp(gsm_rx_buffer, "> ")) BITSET(rlm.sta.init_gsm,
  94:Core/Src/main.c ****   }
  95:Core/Src/main.c **** }
