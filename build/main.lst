  49:Core/Inc/controller.h ****     uint8_t valve_ctrl; // Valve control (0 or 1)
  50:Core/Inc/controller.h ****     uint8_t gsm_call_ctrl; // GSM call control (0 or 1)
  51:Core/Inc/controller.h ****     uint8_t gsm_sms_ctrl; // GSM SMS control (0 or 1)
  52:Core/Inc/controller.h **** };
